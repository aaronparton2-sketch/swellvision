<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        entry="SurfDesignApp"
        id="da356ef7-5379-4500-9839-d801816b15c3"
        name="@Strings.AppName"
        type="watchface"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.0.0">

        <!-- Tier 1: All 260x260 round devices (zero code changes needed) -->
        <iq:products>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fr255"/>
            <iq:product id="fr255m"/>
            <iq:product id="fr955"/>
            <iq:product id="fenix8solar47mm"/>
        </iq:products>

        <!-- Phase 3 permissions: Background required with Communications in watchface apps (SDK 8.x).
             UserProfile: steps/calories. Positioning: GPS. Background + Communications: web requests. -->
        <iq:permissions>
            <iq:uses-permission id="UserProfile"/>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Background"/>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>

    </iq:application>
</iq:manifest>
